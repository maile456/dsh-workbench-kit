{
  "name": "dsh-workbench-kit",
  "version": "0.1.0",
  "description": "DSH delivery workflows, verifiable task records, capability discovery, and an optional local Codex worker.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "main": "./src/plugin.js",
  "exports": { ".": "./src/plugin.js", "./core": "./src/core.js", "./codex": "./src/codex-bridge.js" },
  "bin": { "dsh-workbench": "./src/cli.js" },
  "files": ["src/", "skills/", "catalog/", "docs/", "scripts/", "cordis.patch.yml", "README.md", "LICENSE", "PROJECT.md"],
  "scripts": { "test": "node --test tests/*.test.js", "demo": "node scripts/demo.mjs", "doctor": "node src/cli.js doctor", "verify": "node scripts/verify.mjs" },
  "dsh": { "bundle": { "patch": "cordis.patch.yml" } },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  }
}
